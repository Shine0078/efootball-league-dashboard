generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model League {
  id        String   @id @default(cuid())
  name      String
  type      String   @default("normal") // "normal" | "tournament"
  status    String   @default("active") // "active" | "completed" | "archived"
  createdAt DateTime @default(now())

  players Player[]
  matches Match[]

  @@index([status])
}

model Player {
  id        String   @id @default(cuid())
  name      String
  avatar    String?
  order     Int      @default(0)
  leagueId  String?
  createdAt DateTime @default(now())

  league      League? @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  homeMatches Match[]  @relation("HomePlayer")
  awayMatches Match[]  @relation("AwayPlayer")

  @@index([order])
  @@index([leagueId])
}

model Match {
  id           String    @id @default(cuid())
  homePlayerId String?
  awayPlayerId String?
  homeGoals    Int?
  awayGoals    Int?
  playedAt     DateTime?
  leg          String    @default("") // "home" | "away" for normal leagues, "" for tournament
  status       String    @default("scheduled") // "scheduled" | "completed" | "bye"
  leagueId     String?
  round        Int? // null for normal, 0-indexed round number for tournament
  nextMatchId  String? // for tournament: the match the winner advances to
  bracketPosition Int? // position within the round
  winnerOverride String? // overrides winner for draws (penalties/extra time)
  createdAt    DateTime  @default(now())

  homePlayer Player?  @relation("HomePlayer", fields: [homePlayerId], references: [id], onDelete: Cascade)
  awayPlayer Player?  @relation("AwayPlayer", fields: [awayPlayerId], references: [id], onDelete: Cascade)
  league     League?  @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([leagueId])
  @@index([round])
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   @default("admin") // "admin" | "super"
  createdAt    DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  detail    String?
  createdAt DateTime @default(now())
}