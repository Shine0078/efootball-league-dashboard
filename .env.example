# A long random string used to sign the session cookie. Change in production.
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Default admin created by the seed script.
ADMIN_EMAIL=admin@league.local
ADMIN_PASSWORD=admin123

# SQLite database file (Prisma) — used for local development.
# On Vercel, SQLite is ephemeral (data lost on each deploy).
# For persistent production storage, use Turso below instead.
DATABASE_URL="file:./prisma/data/league.sqlite"

# --- Persistent Production Storage (Turso) ---
# Uncomment these and set your Turso database credentials for production.
# Create a free Turso database at https://turso.tech
# Then run: npx turso db create efootball-league
# Get the URL: npx turso db show efootball-league
# Get the token: npx turso db tokens create efootball-league
# TURSO_DATABASE_URL=libsql://efootball-league-<org>.turso.io
# TURSO_DATABASE_TURSO_AUTH_TOKEN=<your-token-here>
